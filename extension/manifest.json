{
    "manifest_version": 3,
    "name": "Browser AI Copilot",
    "version": "1.0.0",
    "action": {
        "default_popup": "popup.html"
    },
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "http://localhost/*",
        "http://127.0.0.1/*"
    ]
}